# Copy to `.secrets` (gitignored) and fill in.
# Used by `act` via `--secret-file .secrets` for local execution of the GH Actions workflows.
#
# Generate the SP with:
#   az ad sp create-for-rbac \
#     --name "cmk-foundry-tf-deploy" \
#     --role Contributor \
#     --scopes /subscriptions/<SUBSCRIPTION_ID>
#
# Then grant the SP the additional roles it needs (one-time):
#   PRINCIPAL_ID=$(az ad sp show --id <appId> --query id -o tsv)
#   # User Access Administrator: needed because Terraform creates role assignments.
#   az role assignment create --role "User Access Administrator" \
#     --assignee-object-id "$PRINCIPAL_ID" --assignee-principal-type ServicePrincipal \
#     --scope /subscriptions/<SUBSCRIPTION_ID>

ARM_CLIENT_ID=00000000-0000-0000-0000-000000000000
ARM_CLIENT_SECRET=replace-me
ARM_TENANT_ID=00000000-0000-0000-0000-000000000000
